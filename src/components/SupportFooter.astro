---
import { siteConfig } from "../config/site";
---

<footer class="site-footer">
  <section class="support" aria-labelledby="support-heading">
    <div class="coffee-mark" aria-hidden="true">
      <svg viewBox="0 0 40 40" width="40" height="40">
        <path
          d="M8 12h20v11a8 8 0 0 1-8 8h-4a8 8 0 0 1-8-8V12Z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"></path>
        <path
          d="M28 15h2.5a4 4 0 0 1 0 8H28M13 7c0 1.8 2 1.8 2 3.6M20 6c0 2.2 2 2.2 2 4.4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"></path>
      </svg>
    </div>
    <div>
      <h2 id="support-heading">Enjoyed this project?</h2>
      <p>
        If this gave you a useful way to think about our shared future, you can
        buy me a coffee and help support continued research, writing, and
        improvements to the site.
      </p>
    </div>
    <a
      href={siteConfig.donationUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Buy me a coffee to support this project (opens in a new tab)"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
        <path
          d="M4 7h13v7a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V7Z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"></path>
        <path
          d="M17 9h1.5a3 3 0 0 1 0 6H17M8 3v2m4-2v2"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"></path>
      </svg>
      Buy me a coffee
    </a>
  </section>
  <div class="legal-line">
    <p>{siteConfig.name} · {siteConfig.attribution}</p>
    <p>Illustrative, open to challenge, and built without tracking.</p>
  </div>
</footer>

<style>
  .site-footer {
    width: min(calc(100% - 2.5rem), 72rem);
    padding: 0 0 2rem;
    margin: 0 auto;
  }

  .support {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.2rem;
    padding: clamp(1.3rem, 3vw, 2rem);
    border: 1px solid var(--border-strong);
    border-radius: 0.85rem;
    background: var(--surface);
  }

  .coffee-mark {
    display: grid;
    width: 3.5rem;
    height: 3.5rem;
    place-items: center;
    border-radius: 50%;
    background: var(--active-soft);
    color: var(--active-ink);
    transition:
      color 220ms ease,
      background-color 220ms ease;
  }

  h2 {
    margin: 0;
    font-size: 1.2rem;
    letter-spacing: -0.025em;
  }

  .support p {
    max-width: 43rem;
    margin: 0.38rem 0 0;
    color: var(--ink-muted);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .support > a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2.9rem;
    padding: 0.65rem 0.9rem;
    border: 1px solid var(--ink);
    border-radius: 0.58rem;
    background: var(--ink);
    color: #fff;
    font-size: 0.76rem;
    font-weight: 760;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }

  .support > a:hover {
    border-color: var(--active-ink);
    background: var(--active-ink);
    transform: translateY(-1px);
  }

  .legal-line {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    color: var(--ink-soft);
    font-size: 0.64rem;
    line-height: 1.4;
  }

  .legal-line p {
    margin: 0;
  }

  @media (max-width: 700px) {
    .site-footer {
      width: min(calc(100% - 2rem), 72rem);
    }

    .support {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .support > a {
      grid-column: 2;
      justify-self: start;
    }

    .legal-line {
      display: grid;
    }
  }

  @media (max-width: 440px) {
    .support {
      grid-template-columns: 1fr;
    }

    .support > a {
      grid-column: 1;
      width: 100%;
    }
  }

  @media (max-width: 360px) {
    .site-footer {
      width: min(calc(100% - 1.5rem), 72rem);
    }
  }
</style>
