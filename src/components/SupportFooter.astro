---
import { siteConfig } from "../config/site";
---

<footer class="site-footer">
  <section class="support" aria-labelledby="support-heading">
    <svg aria-hidden="true" viewBox="0 0 40 40" width="38" height="38">
      <path
        d="M8 12h20v11a8 8 0 0 1-8 8h-4a8 8 0 0 1-8-8V12Z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"></path>
      <path
        d="M28 15h2.5a4 4 0 0 1 0 8H28M13 7c0 1.8 2 1.8 2 3.6M20 6c0 2.2 2 2.2 2 4.4"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"></path>
    </svg>
    <div>
      <h2 id="support-heading">Enjoyed this project?</h2>
      <p>
        If it gave you something useful to think about, you can buy me a coffee
        and support continued work on the site.
      </p>
    </div>
    <a
      href={siteConfig.donationUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Buy me a coffee to support this project (opens in a new tab)"
    >
      Buy me a coffee
    </a>
  </section>
  <div class="legal-line">
    <p>{siteConfig.name} · {siteConfig.attribution}</p>
    <p>Built without tracking.</p>
  </div>
</footer>

<style>
  .site-footer {
    width: min(calc(100% - 2.5rem), 72rem);
    padding: 0 0 2rem;
    margin: 0 auto;
  }

  .support {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.4rem;
    border-top: 1px solid var(--border-strong);
    border-bottom: 1px solid var(--border-strong);
  }

  .support > svg {
    color: var(--active-ink);
  }

  .support h2 {
    margin: 0;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }

  .support p {
    max-width: 42rem;
    margin: 0.25rem 0 0;
    color: var(--ink-muted);
    font-size: 0.76rem;
    line-height: 1.45;
  }

  .support > a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.6rem 0.85rem;
    border: 1px solid var(--ink);
    border-radius: 0.52rem;
    background: var(--ink);
    color: #fff;
    font-size: 0.74rem;
    font-weight: 750;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }

  .support > a:hover {
    border-color: var(--active-ink);
    background: var(--active-ink);
    transform: translateY(-1px);
  }

  .legal-line {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.85rem;
    color: var(--ink-soft);
    font-size: 0.68rem;
    line-height: 1.4;
  }

  .legal-line p {
    margin: 0;
  }

  @media (max-width: 650px) {
    .site-footer {
      width: min(calc(100% - 2rem), 72rem);
    }

    .support {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .support > a {
      grid-column: 2;
      justify-self: start;
    }
  }

  @media (max-width: 440px) {
    .support {
      grid-template-columns: 1fr;
      padding-right: 0;
      padding-left: 0;
    }

    .support > a {
      grid-column: 1;
      width: 100%;
    }

    .legal-line {
      display: grid;
    }
  }

  @media (max-width: 360px) {
    .site-footer {
      width: min(calc(100% - 1.5rem), 72rem);
    }
  }
</style>
