---
import { businessAsUsual } from "../data/presets";
import { archiveArchetypes } from "../data/scenarios";
import { evaluateFuture } from "../lib/futureModel";

const initialEvaluation = evaluateFuture(businessAsUsual);
const initialPrimary = initialEvaluation.match.primary.scenarioId;
const initialSecondary = initialEvaluation.match.secondary.scenarioId;
---

<section id="scenarios" class="archive" aria-labelledby="archive-heading">
  <header class="archive-header">
    <h2 id="archive-heading">Explore the archetypes</h2>
    <p>Open an archetype to see the institutions and tradeoffs behind it.</p>
  </header>

  <div class="archive-list">
    {
      archiveArchetypes.map((scenario) => (
        <details
          id={scenario.slug}
          class="scenario-entry"
          data-animated-details
          data-scenario-entry={scenario.id}
          data-primary={scenario.id === initialPrimary ? "true" : "false"}
          data-secondary={scenario.id === initialSecondary ? "true" : "false"}
          style={`--entry-accent: ${scenario.accent.color}; --entry-soft: ${scenario.accent.soft}; --entry-ink: ${scenario.accent.ink};`}
        >
          <summary>
            <span class="scenario-title">
              <span class="scenario-heading-row">
                <strong>{scenario.name}</strong>
                <small data-match-state>
                  {scenario.id === initialPrimary
                    ? "Closest"
                    : scenario.id === initialSecondary
                      ? "Nearby"
                      : ""}
                </small>
              </span>
              <span>{scenario.summary}</span>
            </span>
            <span class="scenario-coordinates">
              Shared benefit {Math.round(scenario.center.sharedBenefit)} /
              Public agency {Math.round(scenario.center.publicAgency)} /
              Automation {Math.round(scenario.center.automation)}
            </span>
            <span
              class="scenario-chevron"
              data-disclosure-chevron
              aria-hidden="true"
            >
              <svg viewBox="0 0 20 20" focusable="false">
                <path d="m5.5 7.5 4.5 4.5 4.5-4.5" />
              </svg>
            </span>
          </summary>

          <div class="scenario-reveal" data-disclosure-reveal>
            <div class="scenario-reveal-inner" data-disclosure-inner>
              <div class="scenario-details">
                <p class="snapshot">{scenario.snapshot}</p>

                <dl class="characteristics">
                  <div>
                    <dt>Work</dt>
                    <dd>{scenario.employment}</dd>
                  </div>
                  <div>
                    <dt>Ownership</dt>
                    <dd>{scenario.ownership}</dd>
                  </div>
                  <div>
                    <dt>Power</dt>
                    <dd>{scenario.politicalStructure}</dd>
                  </div>
                  <div>
                    <dt>Necessities</dt>
                    <dd>{scenario.necessities}</dd>
                  </div>
                </dl>

                <div class="movement-grid">
                  <section>
                    <h3>Risks</h3>
                    <ul>
                      {scenario.primaryRisks.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </section>
                  <section>
                    <h3>Toward</h3>
                    <ul>
                      {scenario.toward.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </section>
                  <section>
                    <h3>Away</h3>
                    <ul>
                      {scenario.away.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </section>
                </div>
              </div>
            </div>
          </div>
        </details>
      ))
    }
  </div>
</section>

<script>
  interface SimulatorStateDetail {
    scenarioId?: string | undefined;
    secondaryScenarioId?: string | undefined;
  }

  function markCurrentState(detail: SimulatorStateDetail) {
    document
      .querySelectorAll<HTMLElement>("[data-scenario-entry]")
      .forEach((entry) => {
        const isPrimary = entry.dataset.scenarioEntry === detail.scenarioId;
        const isSecondary =
          entry.dataset.scenarioEntry === detail.secondaryScenarioId;
        entry.dataset.primary = String(isPrimary);
        entry.dataset.secondary = String(isSecondary);
        const summary = entry.querySelector<HTMLElement>("summary");
        const state = entry.querySelector<HTMLElement>("[data-match-state]");
        if (state)
          state.textContent = isPrimary
            ? "Closest"
            : isSecondary
              ? "Nearby"
              : "";
        if (isPrimary) summary?.setAttribute("aria-current", "true");
        else summary?.removeAttribute("aria-current");
      });
  }

  window.addEventListener("abundance:statechange", (event) => {
    markCurrentState((event as CustomEvent<SimulatorStateDetail>).detail ?? {});
  });

  window.setTimeout(() => {
    markCurrentState({
      scenarioId: document.documentElement.dataset.scenario,
      secondaryScenarioId: document.documentElement.dataset.secondaryScenario,
    });
  }, 0);
</script>

<style>
  .archive {
    width: min(calc(100% - 2.5rem), 72rem);
    padding: clamp(3.5rem, 7vw, 5.5rem) 0;
    margin: 0 auto;
  }

  .archive-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
  }

  .archive-header {
    margin-bottom: 1.25rem;
  }

  .archive-header h2 {
    margin: 0;
    font-size: clamp(1.8rem, 3.6vw, 2.8rem);
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .archive-header p {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.82rem;
    line-height: 1.4;
    text-align: right;
  }

  .archive-list {
    border-top: 1px solid var(--border-strong);
  }

  .scenario-entry {
    scroll-margin-top: 1rem;
    border-bottom: 1px solid var(--border-strong);
    background: transparent;
    transition:
      background-color 200ms ease,
      box-shadow 200ms ease;
  }

  .scenario-entry[data-primary="true"] {
    background: var(--entry-soft);
    box-shadow: inset 3px 0 0 var(--entry-accent);
  }

  .scenario-entry[data-secondary="true"] {
    background: color-mix(in srgb, var(--entry-soft) 42%, transparent);
    box-shadow: inset 1px 0 0 var(--entry-accent);
  }

  .scenario-entry > summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.75fr) 1.75rem;
    align-items: center;
    gap: 1rem;
    min-height: 5rem;
    padding: 0.75rem 1rem;
    cursor: pointer;
    list-style: none;
  }

  .scenario-entry > summary::-webkit-details-marker {
    display: none;
  }

  .scenario-title {
    display: grid;
    gap: 0.22rem;
    min-width: 0;
  }

  .scenario-heading-row {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
  }

  .scenario-title strong {
    color: var(--ink);
    font-size: clamp(1rem, 1.8vw, 1.25rem);
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .scenario-heading-row small {
    min-width: 3.1rem;
    color: var(--entry-ink);
    font-size: 0.62rem;
    font-weight: 760;
    line-height: 1;
  }

  .scenario-title > span:last-child,
  .scenario-coordinates {
    color: var(--ink-muted);
    font-size: 0.74rem;
    line-height: 1.4;
  }

  .scenario-coordinates {
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .scenario-chevron {
    display: grid;
    width: 1.75rem;
    height: 1.75rem;
    place-items: center;
    border: 1px solid
      color-mix(in srgb, var(--entry-accent) 34%, var(--border-strong));
    border-radius: 50%;
    background: var(--entry-soft);
    color: var(--entry-ink);
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .scenario-chevron svg {
    width: 0.9rem;
    height: 0.9rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (hover: hover) {
    .scenario-entry > summary:hover .scenario-title strong {
      color: var(--entry-ink);
    }

    .scenario-entry > summary:hover .scenario-chevron {
      border-color: var(--entry-accent);
      background: var(--surface);
    }
  }

  .scenario-details {
    padding: 0 1rem 1.35rem;
  }

  .snapshot {
    max-width: 56rem;
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.84rem;
    line-height: 1.55;
  }

  .characteristics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 62rem;
    margin: 1rem 0 0;
    border-top: 1px solid var(--border);
  }

  .characteristics > div {
    display: grid;
    grid-template-columns: 5.2rem minmax(0, 1fr);
    gap: 0.65rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--border);
  }

  .characteristics > div:nth-child(odd) {
    padding-right: 1rem;
  }

  .characteristics > div:nth-child(even) {
    padding-left: 1rem;
    border-left: 1px solid var(--border);
  }

  dt,
  .movement-grid h3 {
    margin: 0;
    color: var(--entry-ink);
    font-size: 0.69rem;
    font-weight: 760;
    line-height: 1.4;
  }

  dd {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.73rem;
    line-height: 1.42;
  }

  .movement-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.35rem;
    max-width: 62rem;
    margin-top: 1rem;
  }

  .movement-grid ul {
    padding-left: 1rem;
    margin: 0.32rem 0 0;
    color: var(--ink-muted);
    font-size: 0.72rem;
    line-height: 1.42;
  }

  .movement-grid li + li {
    margin-top: 0.22rem;
  }

  .movement-grid li::marker {
    color: var(--entry-accent);
  }

  @media (max-width: 760px) {
    .archive {
      width: min(calc(100% - 2rem), 72rem);
    }

    .archive-header {
      display: block;
    }

    .archive-header p {
      margin-top: 0.4rem;
      text-align: left;
    }

    .scenario-entry > summary {
      grid-template-columns: minmax(0, 1fr) 1.75rem;
      gap: 0.65rem;
      padding-right: 0.65rem;
      padding-left: 0.65rem;
    }

    .scenario-coordinates {
      grid-column: 1;
      text-align: left;
    }

    .scenario-chevron {
      grid-column: 2;
      grid-row: 1 / span 2;
    }

    .scenario-details {
      padding-right: 0.65rem;
      padding-left: 0.65rem;
    }

    .characteristics,
    .movement-grid {
      grid-template-columns: 1fr;
    }

    .characteristics > div:nth-child(odd),
    .characteristics > div:nth-child(even) {
      padding-right: 0;
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (max-width: 360px) {
    .archive {
      width: min(calc(100% - 1.5rem), 72rem);
    }

    .scenario-heading-row {
      display: grid;
      gap: 0.2rem;
    }

    .scenario-heading-row small {
      min-width: 0;
    }

    .scenario-coordinates {
      font-size: 0.68rem;
    }
  }
</style>
