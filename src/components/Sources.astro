---
import { sources } from "../data/sources";
---

{
  sources.length > 0 && (
    <section id="sources" class="sources" aria-labelledby="sources-heading">
      <header>
        <h2 id="sources-heading">Sources and further reading</h2>
        <p>Verified work informing the questions behind the simulator.</p>
      </header>

      <ol class="source-list">
        {sources.map((source) => (
          <li>
            <details data-animated-details>
              <summary>
                <span class="source-copy">
                  <span class="source-title">{source.title}</span>
                  <span class="source-meta">
                    {source.authorOrOrganization} · {source.year}
                  </span>
                </span>
                <span
                  class="source-chevron"
                  data-disclosure-chevron
                  aria-hidden="true"
                >
                  <svg viewBox="0 0 20 20" focusable="false">
                    <path d="m5.5 7.5 4.5 4.5 4.5-4.5" />
                  </svg>
                </span>
              </summary>
              <div class="source-reveal" data-disclosure-reveal>
                <div class="source-reveal-inner" data-disclosure-inner>
                  <div class="source-detail">
                    <p>{source.relevance}</p>
                    <a href={source.url} rel="noreferrer">
                      Read at {source.publication}
                      <span class="sr-only">(opens the source website)</span>
                    </a>
                  </div>
                </div>
              </div>
            </details>
          </li>
        ))}
      </ol>
    </section>
  )
}

<style>
  .sources {
    width: min(calc(100% - 2.5rem), 72rem);
    padding: clamp(3.2rem, 6vw, 4.8rem) 0;
    margin: 0 auto;
  }

  .sources > header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1rem;
  }

  .sources h2 {
    margin: 0;
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .sources > header p {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.8rem;
    text-align: right;
  }

  .source-list {
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--border-strong);
    list-style: none;
  }

  .source-list li {
    border-bottom: 1px solid var(--border-strong);
  }

  .source-list summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1.75rem;
    align-items: center;
    gap: 1rem;
    min-height: 3.4rem;
    padding: 0.65rem 0.25rem;
    cursor: pointer;
    list-style: none;
    transition:
      color 180ms ease,
      background-color 180ms ease;
  }

  .source-list summary::-webkit-details-marker {
    display: none;
  }

  .source-list details[data-expanded="true"] > summary {
    background: color-mix(in srgb, var(--active-soft) 58%, transparent);
  }

  .source-copy {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(13rem, 0.65fr);
    align-items: baseline;
    gap: 1rem;
    min-width: 0;
  }

  .source-title {
    color: var(--ink);
    font-size: 0.79rem;
    font-weight: 720;
    line-height: 1.35;
  }

  .source-meta {
    color: var(--ink-muted);
    font-size: 0.7rem;
    line-height: 1.4;
    text-align: right;
  }

  .source-chevron {
    display: grid;
    width: 1.75rem;
    height: 1.75rem;
    place-items: center;
    border: 1px solid
      color-mix(in srgb, var(--active-accent) 34%, var(--border-strong));
    border-radius: 50%;
    background: var(--active-soft);
    color: var(--active-ink);
    transition:
      color 180ms ease,
      background-color 180ms ease,
      border-color 180ms ease,
      transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .source-chevron svg {
    width: 0.9rem;
    height: 0.9rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (hover: hover) {
    .source-list summary:hover {
      background: var(--active-soft);
    }

    .source-list summary:hover .source-chevron {
      border-color: var(--active-accent);
      background: var(--surface);
    }
  }

  .source-detail {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0 0.25rem 0.85rem 1.2rem;
  }

  .source-detail p {
    max-width: 49rem;
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.73rem;
    line-height: 1.48;
  }

  .source-detail a {
    flex: 0 0 auto;
    color: var(--active-ink);
    font-size: 0.72rem;
    font-weight: 720;
    text-underline-offset: 0.2em;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 700px) {
    .sources {
      width: min(calc(100% - 2rem), 72rem);
    }

    .sources > header {
      display: block;
    }

    .sources > header p {
      margin-top: 0.4rem;
      text-align: left;
    }

    .source-copy {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }

    .source-meta {
      text-align: left;
    }

    .source-detail {
      display: block;
    }

    .source-detail a {
      display: inline-block;
      margin-top: 0.55rem;
    }
  }

  @media (max-width: 360px) {
    .sources {
      width: min(calc(100% - 1.5rem), 72rem);
    }
  }
</style>
